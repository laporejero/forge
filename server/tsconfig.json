{
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "target": "ES2020",
    "module": "Node16",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node16",
    "noImplicitAny": true,
    "strictNullChecks": true
  },
  "ts-node": {
    "esm": false
  },
  "include": ["**/*.ts", "vitest.config.mts"],
  "exclude": ["node_modules", "dist"]
}
